# ==============================================================================
# Voice Bot Configuration
# ==============================================================================

# Primary LLM & STT Provider (Required for speech & primary reasoning)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Fallback LLM Provider (Google Gemini Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Environment (development | production | testing)
APP_ENV=development

# Server Networking
PORT=8000
HOST=0.0.0.0

# Rate Limiting & Safety Quota
RATE_LIMIT_PER_MINUTE=20/minute
GLOBAL_DAILY_LIMIT=1000

# Edge-TTS Neural Voice (e.g., en-US-ChristopherNeural, en-US-GuyNeural, en-US-JennyNeural)
TTS_VOICE=en-US-ChristopherNeural

# Pre-synthesize sample audio on startup (set to true on production server with active internet)
PREWARM_AUDIO_CACHE=false
